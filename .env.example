# ===== Обязательно =====
# Токен основного бота (Telegram). Без него бот не стартует.
BOT_TOKEN=your_bot_token_here

# ===== Опционально =====
# Админ-бот: включается, если заданы оба ключа.
ADMIN_BOT_TOKEN=your_admin_bot_token_here
ADMIN_ID=your_admin_telegram_id_here

# Функции бота (вкл/выкл).
HANDLE_VACATION=true
DAILY_BROADCAST=true
PAIR_NOTIFICATION=true
CHANGE_ALERT=true

# Шаблоны скриншотов расписания (светлая/тёмная темы).
SCHEDULE_TEMPLATE_FILE=templates/light.html
SCHEDULE_TEMPLATE_DARK_FILE=templates/dark.html

# Источник прокси для подключения к Telegram (SOCKS5, не-РФ).
PROXY_SOURCE_URL=https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/all/data.json

# Браузер для скриншотов расписания (chromedp).
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30s
BROWSER_SCALE=1.0 # Для быстрого изменения размера скриншошта без изменения width/height
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
BROWSER_RESTART_INTERVAL=24h

# API-скрейпер (cmd/api), к которому обращается бот.
SCRAPER_HOST=localhost
SCRAPER_PORT=8080

# Redis — кэш расписаний API. Для локального запуска cmd/api нужен Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=your_redis_password_here

# Логирование. LOG_LEVEL=trace включает подробный вывод бота.
LOG_LEVEL=trace
LOG_DIR=storage/logs

# Каталоги и TTL.
CACHE_DIR=storage/cache
SCREENSHOT_DIR=storage/screenshots

# База данных. DB_DRIVER=sqlite3 (файл DB_FILE) или postgres (ключи DB_HOST..DB_NAME).
# SQLite-миграции лежат в migrations/, postgres — в migrations/postgres/.
DB_DRIVER=sqlite3
DB_FILE=storage/database/data.db
DB_MIGRATION_DIR=migrations
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=raspishika
DB_NAME=raspishika
DB_SSLMODE=disable

CHAT_STATE_TTL=10m
CACHE_SCHEDULE_TTL=30m
PAIR_NOTIFICATION_TTL=90m
UPDATE_MONITOR_INTERVAL=25m
