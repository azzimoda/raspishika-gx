# ===== Обязательно =====
# Токен основного бота (Telegram). Без него бот не стартует.
BOT_TOKEN=your_bot_token_here

# ===== VK-бот (cmd/vkbot / cmd/fakevkbot) =====
# Токен сообщества VK и его ID. Бот общается через VK Bots Long Poll.
VK_GROUP_TOKEN=your_vk_group_token_here
VK_GROUP_ID=your_vk_group_id_here
VK_API_VERSION=5.199

# ===== Опционально =====
# Админ-бот: включается, если заданы оба ключа.
ADMIN_BOT_TOKEN=your_admin_bot_token_here
ADMIN_ID=your_admin_telegram_id_here

# Функции бота (вкл/выкл).
HANDLE_VACATION=true
DAILY_BROADCAST=true
PAIR_NOTIFICATION=true
CHANGE_ALERT=true

# Шаблоны скриншотов расписания (светлая/тёмная темы).
SCHEDULE_TEMPLATE_FILE=templates/light.html
SCHEDULE_TEMPLATE_DARK_FILE=templates/dark.html

# Источник прокси для подключения к Telegram (SOCKS5, не-РФ) — fallback.
PROXY_SOURCE_URL=https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/all/data.json

# Основной прокси: локальный mixed (SOCKS5/HTTP) in-bound justray в proxy-режиме
# (justray up --proxy). Пусто — только PROXY_SOURCE_URL.
# В Docker-контейнерах используйте host.docker.internal:10808 (при allow_lan: on).
JUSTRAY_PROXY_ADDR=127.0.0.1:10808

# Ротатор узлов justray (cmd/justray-rotate, ставится как systemd-юнит):
# путь к бинарнику justray и URL, достижимость которого проверяется через прокси.
JUSTRAY_BIN=justray
JUSTRAY_PROBE_URL=https://api.telegram.org/

# Как часто проверять прокси, сколько провалов подряд до ротации узла,
# паузы между ротациями и длинный backoff после серии неудач.
JUSTRAY_CHECK_INTERVAL=20s
JUSTRAY_FAILURE_THRESHOLD=3
JUSTRAY_COOLDOWN=60s
JUSTRAY_MAX_ROTATIONS=3
JUSTRAY_LONG_BACKOFF=10m

# Дополнительные подстроки для исключения узлов (через запятую).
# РФ-узлы (🇷🇺/«Россия») и «Для моб. операторов» исключаются всегда.
JUSTRAY_EXCLUDE=

# Сколько времени прокси, многократно сломавшийся при отправке, держится в бане.
PROXY_BAN_COOLDOWN=5m

# Браузер для скриншотов расписания (chromedp).
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30s
BROWSER_SCALE=1.0 # Для быстрого изменения размера скриншошта без изменения width/height
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
BROWSER_RESTART_INTERVAL=24h

# API-скрейпер (cmd/api), к которому обращается бот.
SCRAPER_HOST=localhost
SCRAPER_PORT=8080

# Redis — кэш расписаний API. Для локального запуска cmd/api нужен Redis.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=your_redis_password_here

# Логирование. LOG_LEVEL=trace включает подробный вывод бота.
LOG_LEVEL=trace
LOG_DIR=storage/logs

# Каталоги и TTL.
CACHE_DIR=storage/cache
SCREENSHOT_DIR=storage/screenshots

# База данных. DB_DRIVER=sqlite3 (файл DB_FILE) или postgres (ключи DB_HOST..DB_NAME).
# SQLite-миграции лежат в migrations/, postgres — в migrations/postgres/.
DB_DRIVER=sqlite3
DB_FILE=storage/database/data.db
DB_MIGRATION_DIR=migrations
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=raspishika
DB_NAME=raspishika
DB_SSLMODE=disable

CHAT_STATE_TTL=10m
CACHE_SCHEDULE_TTL=30m
PAIR_NOTIFICATION_TTL=90m
UPDATE_MONITOR_INTERVAL=25m
