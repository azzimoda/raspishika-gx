[Unit]
Description=Justray node rotator for Распиши-ка
# Depends on the justray daemon (justrayd) already running on this host.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The rotator reads .env from here itself (godotenv), so the unit does not
# inject it: EnvironmentFile would put every secret in the repo's .env, bot
# tokens included, into this process's environment for no benefit.
WorkingDirectory=__REPO_DIR__
# A systemd user manager has a minimal PATH, and justray is resolved by name.
# %h is the user's home: the official justray installer and `x eget` both land
# in ~/.local/bin, which the distro defaults below do not include.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__BIN_DIR__/justray-rotate
# Run returns nil on a cancelled context, so a clean exit is the normal shutdown
# path and on-failure would not bring the rotator back after an unexpected exit.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
